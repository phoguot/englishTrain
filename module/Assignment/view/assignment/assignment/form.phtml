            <option value="draft" <?= $values['status'] === 'draft' ? 'selected' : '' ?>>Nháp — học sinh chưa thấy</option>
            <option value="published" <?= $values['status'] === 'published' ? 'selected' : '' ?>>Đã giao</option>
            <option value="closed" <?= $values['status'] === 'closed' ? 'selected' : '' ?>>Đã đóng</option>
        </select>
        <span class="field__help<?= isset($errors['status']) ? ' field__help--error' : '' ?>" id="assignment-status-error">
            <?= isset($errors['status']) ? $this->escapeHtml($errors['status']) : 'Bản nháp chỉ giáo viên nhìn thấy.' ?>
        </span>
    </div>

    <section id="quiz-section" class="field--wide panel panel--tint <?= $values['type'] === 'quiz' ? '' : 'd-none' ?>">
        <div class="panel__head">
            <h2>Câu hỏi trắc nghiệm</h2>
            <button type="button" id="add-question" class="btn btn--outline">Thêm câu hỏi</button>
        </div>
        <div id="questions"></div>
    </section>

    <div class="field--wide button-row">
        <button class="btn" type="submit"><?= $isEdit ? 'Lưu thay đổi' : 'Tạo bài tập' ?></button>
        <a class="btn btn--quiet"
           href="<?= $this->url('assignments', [], ['query' => ['classroom' => (int) $values['classroom_id']]]) ?>">Hủy</a>
    </div>
</form>

<textarea id="existing-questions" class="d-none" aria-hidden="true"><?= $this->escapeHtml(json_encode(
    $quizJson,
    JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT,
)) ?></textarea>
