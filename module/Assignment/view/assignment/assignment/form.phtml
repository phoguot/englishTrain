<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var bool $isEdit
 * @var int|null $editId
 * @var array<string,mixed> $values
 * @var array<string,string> $errors
 * @var array<int, array{question:string,options:string[],correct_index:int}> $quizJson
 * @var array<int, array<string,mixed>> $classrooms
 */
$action = $isEdit ? $this->url('assignment_edit', ['id' => $editId]) : $this->url('assignment_create');
$deadlineValue = '';
if (($values['deadline_at'] ?? '') !== '') {
    $timestamp = strtotime((string) $values['deadline_at']);
    $deadlineValue = $timestamp !== false ? date('Y-m-d\TH:i', $timestamp) : '';
}
?>
<div class="page-head">
    <div class="page-head__copy">
        <p class="eyebrow">Assignment</p>
        <h1><?= $isEdit ? 'Sửa bài tập.' : 'Tạo bài tập.' ?></h1>
        <p>Viết đề bài rõ ràng, chọn hạn nộp và trạng thái trước khi giao.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn--outline"
           href="<?= $this->url('assignments', [], ['query' => ['classroom' => (int) $values['classroom_id']]]) ?>">Quay lại</a>
    </div>
</div>

<?php if (isset($errors['quiz'])): ?>
    <div class="alert alert-danger" role="alert"><?= $this->escapeHtml($errors['quiz']) ?></div>
<?php endif; ?>

<form method="post" action="<?= $this->escapeHtmlAttr($action) ?>" class="panel form-grid">
    <input type="hidden" name="_csrf" value="<?= $this->escapeHtmlAttr($csrfToken) ?>">
    <div class="field">
        <label for="classroom_id">Lớp</label>
        <select class="field__control" id="classroom_id" name="classroom_id" required
                <?= isset($errors['classroom_id']) ? 'aria-invalid="true" aria-describedby="classroom-error"' : '' ?>>
            <option value="">Chọn lớp</option>
            <?php foreach ($classrooms as $classroom): ?>
                <option value="<?= (int) $classroom['id'] ?>"
                    <?= (int) $values['classroom_id'] === (int) $classroom['id'] ? 'selected' : '' ?>>
                    <?= $this->escapeHtml($classroom['name']) ?>
                </option>
            <?php endforeach; ?>
        </select>
        <span class="field__help<?= isset($errors['classroom_id']) ? ' field__help--error' : '' ?>" id="classroom-error">
            <?= isset($errors['classroom_id']) ? $this->escapeHtml($errors['classroom_id']) : 'Chỉ hiển thị lớp bạn phụ trách.' ?>
        </span>
    </div>

    <div class="field">
        <label for="type">Loại bài</label>
        <select class="field__control" id="type" name="type"
                <?= isset($errors['type']) ? 'aria-invalid="true" aria-describedby="type-error"' : '' ?>>
            <option value="essay" <?= $values['type'] === 'essay' ? 'selected' : '' ?>>Tự luận</option>
            <option value="quiz" <?= $values['type'] === 'quiz' ? 'selected' : '' ?>>Trắc nghiệm</option>
            <option value="video" <?= $values['type'] === 'video' ? 'selected' : '' ?>>Video</option>
        </select>
        <span class="field__help<?= isset($errors['type']) ? ' field__help--error' : '' ?>" id="type-error">
            <?= isset($errors['type']) ? $this->escapeHtml($errors['type']) : 'Video hiện chưa hỗ trợ nộp trực tiếp.' ?>
        </span>
    </div>

    <div class="field field--wide">
        <label for="title">Tiêu đề</label>
        <input class="field__control" type="text" id="title" name="title" maxlength="200"
               value="<?= $this->escapeHtmlAttr((string) $values['title']) ?>" required
               <?= isset($errors['title']) ? 'aria-invalid="true" aria-describedby="title-error"' : '' ?>>
        <span class="field__help<?= isset($errors['title']) ? ' field__help--error' : '' ?>" id="title-error">
            <?= isset($errors['title']) ? $this->escapeHtml($errors['title']) : 'Tiêu đề ngắn, cho học sinh biết ngay việc cần làm.' ?>
        </span>
    </div>

    <div class="field field--wide">
        <label for="description">Đề bài</label>
        <textarea class="field__control" id="description" name="description" rows="5"><?= $this->escapeHtml((string) $values['description']) ?></textarea>
        <span class="field__help">Nêu yêu cầu, độ dài và cách nộp bài.</span>
    </div>

    <div class="field">
        <label for="deadline_at">Hạn nộp</label>
        <input class="field__control" type="datetime-local" id="deadline_at" name="deadline_at"
               value="<?= $this->escapeHtmlAttr($deadlineValue) ?>"
               <?= isset($errors['deadline_at']) ? 'aria-invalid="true" aria-describedby="deadline-error"' : '' ?>>
        <span class="field__help<?= isset($errors['deadline_at']) ? ' field__help--error' : '' ?>" id="deadline-error">
            <?= isset($errors['deadline_at']) ? $this->escapeHtml($errors['deadline_at']) : 'Để trống nếu bài không giới hạn.' ?>
        </span>
    </div>

