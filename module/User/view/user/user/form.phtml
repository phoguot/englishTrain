 */

use User\Model\User\UserModel;

$action = $isEdit ? $this->url('user_edit', ['id' => $editId]) : $this->url('user_create');
?>
<div class="page-head">
    <div class="page-head__copy"><p class="eyebrow">Tài khoản</p><h1><?= $isEdit ? 'Sửa tài khoản.' : 'Tạo tài khoản.' ?></h1></div>
    <div class="page-actions"><a class="btn btn--outline" href="<?= $this->url('users') ?>">Quay lại</a></div>
</div>
<form method="post" action="<?= $this->escapeHtmlAttr($action) ?>" class="panel form-grid">
    <input type="hidden" name="_csrf" value="<?= $this->escapeHtmlAttr($csrfToken) ?>">
    <div class="field"><label for="full_name">Họ tên</label><input class="field__control<?= isset($errors['full_name']) ? ' is-invalid' : '' ?>" id="full_name" name="full_name" maxlength="100" required value="<?= $this->escapeHtmlAttr((string) $values['full_name']) ?>"><?php if (isset($errors['full_name'])): ?><span class="invalid-feedback"><?= $this->escapeHtml($errors['full_name']) ?></span><?php endif; ?></div>
    <div class="field"><label for="role">Vai trò</label><select class="field__control<?= isset($errors['role']) ? ' is-invalid' : '' ?>" id="role" name="role" required><?php foreach (UserModel::ROLE_LABELS as $value => $label): ?><option value="<?= $this->escapeHtmlAttr((string) $value) ?>" <?= (int) $values['role'] === (int) $value ? 'selected' : '' ?>><?= $this->escapeHtml($label) ?></option><?php endforeach; ?></select><?php if (isset($errors['role'])): ?><span class="invalid-feedback"><?= $this->escapeHtml($errors['role']) ?></span><?php endif; ?></div>
    <div class="field<?= (int) $values['role'] === UserModel::ROLE_TEACHER ? '' : ' d-none' ?>" data-teacher-type-field
         data-teacher-role-value="<?= UserModel::ROLE_TEACHER ?>">
        <label for="teacher_type">Loại giáo viên</label>
        <select class="field__control<?= isset($errors['teacher_type']) ? ' is-invalid' : '' ?>" id="teacher_type" name="teacher_type">
            <option value="">Chọn loại giáo viên</option>
            <?php foreach ($teacherTypeLabels as $value => $label): ?>
                <option value="<?= $this->escapeHtmlAttr((string) $value) ?>" <?= (string) $values['teacher_type'] === (string) $value ? 'selected' : '' ?>><?= $this->escapeHtml($label) ?></option>
            <?php endforeach; ?>
        </select>
        <span class="field__help">Chỉ giáo viên tiếng Anh mới giao được bài tập dạng video.</span>
        <?php if (isset($errors['teacher_type'])): ?><span class="invalid-feedback"><?= $this->escapeHtml($errors['teacher_type']) ?></span><?php endif; ?>
    </div>
    <div class="field"><label for="username">Tên đăng nhập</label><input class="field__control<?= isset($errors['username']) ? ' is-invalid' : '' ?>" id="username" name="username" maxlength="50" required value="<?= $this->escapeHtmlAttr((string) $values['username']) ?>"><?php if (isset($errors['username'])): ?><span class="invalid-feedback"><?= $this->escapeHtml($errors['username']) ?></span><?php endif; ?></div>
    <div class="field"><label for="password">Mật khẩu<?= $isEdit ? ' mới' : '' ?></label><input class="field__control<?= isset($errors['password']) ? ' is-invalid' : '' ?>" id="password" name="password" type="password" autocomplete="new-password" <?= $isEdit ? '' : 'required' ?>><?php if ($isEdit): ?><span class="field__help">Để trống nếu không đổi mật khẩu.</span><?php endif; ?><?php if (isset($errors['password'])): ?><span class="invalid-feedback"><?= $this->escapeHtml($errors['password']) ?></span><?php endif; ?></div>
    <div class="field"><label for="email">Email</label><input class="field__control<?= isset($errors['email']) ? ' is-invalid' : '' ?>" id="email" name="email" type="email" maxlength="150" value="<?= $this->escapeHtmlAttr((string) $values['email']) ?>"><?php if (isset($errors['email'])): ?><span class="invalid-feedback"><?= $this->escapeHtml($errors['email']) ?></span><?php endif; ?></div>
    <div class="field"><label for="phone">Số điện thoại</label><input class="field__control<?= isset($errors['phone']) ? ' is-invalid' : '' ?>" id="phone" name="phone" maxlength="20" value="<?= $this->escapeHtmlAttr((string) $values['phone']) ?>"><?php if (isset($errors['phone'])): ?><span class="invalid-feedback"><?= $this->escapeHtml($errors['phone']) ?></span><?php endif; ?></div>
    <div class="field"><label for="status">Trạng thái</label><select class="field__control<?= isset($errors['status']) ? ' is-invalid' : '' ?>" id="status" name="status"><option value="1" <?= (int) $values['status'] === 1 ? 'selected' : '' ?>>Đang hoạt động</option><option value="0" <?= (int) $values['status'] === 0 ? 'selected' : '' ?>>Khóa</option></select><?php if (isset($errors['status'])): ?><span class="invalid-feedback"><?= $this->escapeHtml($errors['status']) ?></span><?php endif; ?></div>
    <div class="field field--wide"><button class="btn" type="submit"><?= $isEdit ? 'Lưu thay đổi' : 'Tạo tài khoản' ?></button> <a class="btn btn--quiet" href="<?= $this->url('users') ?>">Hủy</a></div>
</form>
<?php if ($isEdit): ?>
    <section class="panel mt-4">
        <div class="panel__head"><h2>Liên kết đăng nhập ngoài</h2><span class="panel__meta"><?= count($identities) ?> liên kết</span></div>
        <form method="post" action="<?= $this->url('user_identity_invite', ['id' => (int) $editId]) ?>" class="mb-3">
            <input type="hidden" name="_csrf" value="<?= $this->escapeHtmlAttr($csrfToken) ?>">
            <button class="btn btn--outline" type="submit">Tạo mã liên kết mới</button>
        </form>
        <?php if ($identities === []): ?>
            <p class="muted mb-0">Tài khoản chưa liên kết Google, Facebook hoặc Zalo.</p>
        <?php else: ?>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th scope="col">Nhà cung cấp</th><th scope="col">Email nhận diện</th><th scope="col" class="text-end">Thao tác</th></tr></thead>
                    <tbody>
                    <?php foreach ($identities as $identity): ?>
                        <tr>
                            <td><?= $this->escapeHtml($providerLabels[(string) $identity->getProvider()] ?? (string) $identity->getProvider()) ?></td>
                            <td><?= $this->escapeHtml((string) ($identity->getProviderEmail() ?? '—')) ?></td>
                            <td class="text-end">
                                <form method="post" action="<?= $this->url('user_identity_revoke', ['id' => (int) $editId, 'provider' => (string) $identity->getProvider()]) ?>" class="d-inline" data-confirm-unlink>
                                    <input type="hidden" name="_csrf" value="<?= $this->escapeHtmlAttr($csrfToken) ?>">
                                    <button class="btn btn--quiet" type="submit">Thu hồi</button>
                                </form>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>
    </section>
    <?php if ((int) ($values['role'] ?? 0) !== UserModel::ROLE_ADMIN): ?>
    <section class="panel mt-4">
        <div class="panel__head"><h2>Link đăng nhập nhanh</h2></div>
        <p class="muted">Tạo một link đăng nhập gửi qua Zalo/SMS cho học sinh hoặc giáo viên. Người nhận bấm vào là vào thẳng, không cần gõ mật khẩu. Link dùng một lần, hết hạn sau 15 phút.</p>
        <form method="post" action="<?= $this->url('magic_link_create', ['id' => (int) $editId]) ?>">
            <input type="hidden" name="_csrf" value="<?= $this->escapeHtmlAttr($csrfToken) ?>">
            <button class="btn btn--outline" type="submit">Tạo link đăng nhập</button>
        </form>
    </section>
    <?php endif; ?>
<?php endif; ?>
