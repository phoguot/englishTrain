<?php
/**
 * @var Laminas\View\Renderer\PhpRenderer $this
 * @var bool $isEdit
 * @var int|null $editId
 * @var array<string,mixed> $values
 * @var array<string,string> $errors
 * @var string $csrfToken
 * @var \User\Model\UserIdentity\UserIdentityModel[] $identities
