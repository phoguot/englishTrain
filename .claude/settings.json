{
  "permissions": {
    "allow": [
      "Bash(composer install)",
      "Bash(composer dump-autoload)",
      "Bash(composer serve)",
      "Bash(php -l:*)",
      "Bash(php public/index.php:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(./module/**)",
      "Read(./docs/**)",
      "Read(./config/**)",
      "Read(./data/migrations/**)"
    ],
    "deny": [
      "Read(./config/autoload/local.php)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(mysql:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "php .claude/hooks/kiem-tra-php.php"
          }
        ]
      }
    ]
  }
}
